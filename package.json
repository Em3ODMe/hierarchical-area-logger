{
  "name": "hierarchical-area-logger",
  "version": "0.4.1",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepack": "unbuild",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run format && npm run lint && npm run test && npm run build"
  },
  "pre-commit": [
    "lint"
  ],
  "author": "Roman Jankowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Em3ODMe/hierarchical-area-logger.git"
  },
  "homepage": "https://github.com/Em3ODMe/hierarchical-area-logger#readme",
  "bugs": {
    "url": "https://github.com/Em3ODMe/hierarchical-area-logger/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "description": "Hierarchical Area Logger",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "nodejs"
  ]
}
